# ==============================================================================
# BERVIC MONOREPO .GITIGNORE
# Next.js (Web) + React Native / Expo (Mobile) + Shared Packages + Turbo
# ==============================================================================

# --- Dependencies & Package Managers ---
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Monorepo & Build Cache ---
.turbo/
*.tsbuildinfo
**/*.tsbuildinfo

# --- Next.js Web App ---
.next/
**/.next/
out/
**/out/
build/
dist/
**/dist/
next-env.d.ts
**/next-env.d.ts

# --- React Native & Expo Mobile App ---
.expo/
**/.expo/
expo-env.d.ts
**/expo-env.d.ts
web-build/
android/
ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# --- Environment Variables & Secrets ---
.env
.env*.local
.env.development
.env.test
.env.production
**/.env
**/.env*.local
**/.env.production
*.pem

# --- Logs, Debug & Telemetry ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# --- Vercel & Cloud Deployments ---
.vercel/

# --- Testing & Coverage ---
coverage/
**/coverage/
.nyc_output/

# --- Operating System & Editor Files ---
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/

# --- Temporary / Scratch Scripts & Models ---
apps/web/scratch/
apps/web/scratch_*.html
apps/web/scratch_*.js
apps/web/eng.traineddata
