# ==============================================================================
# BERVIC WEB APP - PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# --- DATABASE (PostgreSQL / Neon / Supabase) ---
DATABASE_URL="postgresql://username:password@ep-xyz.neon.tech/bervic_db?sslmode=require"

# --- NEXTAUTH AUTHENTICATION ---
# Set to your production URL on Vercel (e.g. https://www.bervic.in or https://bervic-invitation.vercel.app)
NEXTAUTH_URL="https://www.bervic.in"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-strong-random-32-byte-secret-key"

# --- GOOGLE OAUTH CREDENTIALS ---
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- APPLICATION & ANALYTICS ---
NEXT_PUBLIC_APP_URL="https://www.bervic.in"
NEXT_PUBLIC_GA_ID="G-83TR44K9KN"
ADMIN_EMAIL="berglin1998@gmail.com"

# --- CLOUDINARY (Media & Image Uploads) ---
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_API_KEY="your-api-key"

# --- RAZORPAY PAYMENT GATEWAY ---
# Production Keys (rzp_live_...) or Test Keys (rzp_test_...)
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxx"

# --- SMTP EMAIL DELIVERY (Nodemailer / Gmail / SendGrid) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
# For Gmail, use an 16-character App Password (Google Account -> Security -> App Passwords)
SMTP_PASS="your-16-char-gmail-app-password"
SMTP_FROM="Bervic Invitations <your-email@gmail.com>"
