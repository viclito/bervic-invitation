generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String           @id @default(cuid())
  name                  String?
  email                 String           @unique
  emailVerified         DateTime?
  password              String?
  image                 String?
  phone                 String?
  plan                  String           @default("NONE") // NONE, BASIC_599, PRO_1799, CINEMATIC_2000
  planExpiresAt         DateTime?
  allowedTemplatesCount Int              @default(0)
  allowedCinematicCount Int              @default(0)
  hasCinematicPass      Boolean          @default(false)
  allowedCardsCount     Int              @default(0)
  role                  String           @default("USER") // USER, SUB_ADMIN, ADMIN, SUPER_ADMIN
  adminPermissions      String[]         @default([])
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  accounts              Account[]
  invitations           UserInvitation[]
  subscriptions         Subscription[]
  payments              Payment[]
  cards                 UserCard[]
  draftDetails          UserDraftDetails[]
  cartItems             CartItem[]
  orders                CardOrder[]
  addresses             UserAddress[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model OtpVerification {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model UserInvitation {
  id                String   @id @default(cuid())
  userId            String
  templateSlug      String
  coupleInitials    String
  partnerOne        String
  partnerTwo        String
  tagline           String
  inviteLine        String
  weddingDate       String
  weddingTime       String
  heroImage         String
  coupleImage       String
  partnerTwoImage   String?
  venuePlace        String
  eventsJson        String   @db.Text
  timelineDayJson   String   @db.Text
  loveStoryText     String   @db.Text
  loveStoryVideoUrl String
  locationsJson     String   @db.Text
  galleryImagesJson String   @db.Text
  contactPhone      String
  contactAddress    String
  socialLinksJson   String   @db.Text
  slug              String   @unique
  isUnlockedByAdmin Boolean  @default(false)
  isLockedByAdmin   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  guests Guest[]
}

model Guest {
  id             String         @id @default(cuid())
  invitationId   String
  name           String
  phone          String
  email          String?
  status         String         @default("PENDING") // PENDING, ATTENDING, DECLINED
  plusOnes       Int            @default(0)
  dietaryNotes   String?        @db.Text
  uniqueCode     String         @default(cuid())
  whatsappSentAt DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  invitation UserInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
}

model Subscription {
  id                String   @id @default(cuid())
  userId            String
  plan              String   // BASIC_599, PRO_1799, CINEMATIC_2000
  amount            Float
  status            String   @default("ACTIVE") // ACTIVE, EXPIRED
  allowedTemplates  Int
  allowedCards      Int
  startsAt          DateTime @default(now())
  expiresAt         DateTime
  razorpayOrderId   String?
  razorpayPaymentId String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Payment {
  id                String   @id @default(cuid())
  userId            String
  razorpayOrderId   String   @unique
  razorpayPaymentId String?
  razorpaySignature String?
  amount            Float
  plan              String
  status            String   @default("CREATED") // CREATED, SUCCESS, FAILED
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserCard {
  id           String   @id @default(cuid())
  userId       String
  templateId   Int
  templateName String
  partnerOne   String
  partnerTwo   String
  weddingDate  String
  weddingTime  String?
  venue        String?
  city         String?
  tagline      String?
  couplePhoto  String?
  hashtag      String?
  cardDataJson String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserDraftDetails {
  id                String   @id @default(cuid())
  userId            String
  profileName       String?  // e.g. "Sasa & Allan's Wedding" or "Main Profile"
  isActive          Boolean  @default(true) // Main active profile for all live template previews
  eventType         String   @default("WEDDING") // WEDDING, BIRTHDAY
  hostNameOne       String?  // Partner One or Birthday Person Name
  hostNameTwo       String?  // Partner Two (if Wedding)
  coupleInitials    String?  // Monogram e.g. "S & A"
  eventTitle        String?  // e.g. "Sasa & Allan's Wedding"
  inviteLine        String?  // Formal invitation line
  eventDate         String?
  eventTime         String?
  venueName         String?
  venueAddress      String?
  venueMapUrl       String?  // Google Maps link for Venue 1
  venueTwoName      String?  // Venue 2 (Reception / Secondary)
  venueTwoAddress   String?  // Venue 2 Address
  venueTwoMapUrl    String?  // Google Maps link for Venue 2
  locationsJson     String?  @db.Text // JSON array of locations
  tagline           String?
  turningAge        String?  // for Birthday
  dressCode         String?
  rsvpContact       String?
  loveStoryText     String?  @db.Text // Our Story text
  loveStoryVideoUrl String?  // Video URL
  coverImage        String?  // Primary couple/host photo
  coupleImage       String?  // Secondary couple photo
  partnerTwoImage   String?  // Individual photo
  venueImage        String?  // Uploaded venue photo
  galleryImagesJson String?  @db.Text // JSON array of gallery image URLs
  functionsJson     String?  @db.Text // JSON array of sub-events (Sangeet, Reception, etc.)
  dayTimelineJson   String?  @db.Text // JSON array of day timeline items (vows, lunch, reception)
  additionalNotes   String?  @db.Text
  extractedFromDoc  Boolean  @default(false)
  completedFields   String?  @db.Text // JSON string array of filled field keys
  currentStep       Int      @default(0)
  isComplete        Boolean  @default(false)
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CartItem {
  id              String   @id @default(cuid())
  userId          String
  itemType        String   @default("CANVA_CARD") // CANVA_CARD, etc.
  templateId      String
  templateName    String
  previewImage    String?  @db.Text
  copies          Int      @default(1)
  cardDetailsJson String   @db.Text
  elementsJson    String?  @db.Text
  customNotes     String?  @db.Text
  price           Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CardOrder {
  id              String          @id @default(cuid())
  orderNumber     String          @unique
  userId          String
  customerName    String
  customerEmail   String
  customerPhone   String
  deliveryAddress String?         @db.Text
  city            String?
  pincode         String?
  status          String          @default("PENDING") // PENDING, CONFIRMED, IN_PRODUCTION, SHIPPED, DELIVERED, CANCELLED
  totalCopies     Int             @default(1)
  totalAmount     Float           @default(0)
  shippingFee     Float           @default(0)
  paymentStatus   String          @default("PENDING") // PENDING, PAID, COD
  notes           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           CardOrderItem[]
  messages        OrderMessage[]

  @@index([userId])
  @@index([status])
}

model CardOrderItem {
  id              String    @id @default(cuid())
  orderId         String
  itemType        String    @default("CANVA_CARD")
  templateId      String
  templateName    String
  previewImage    String?   @db.Text
  copies          Int       @default(1)
  cardDetailsJson String    @db.Text
  elementsJson    String?   @db.Text
  customNotes     String?   @db.Text
  draftFileUrl    String?   @db.Text
  draftFileName   String?
  price           Float     @default(0)
  createdAt       DateTime  @default(now())

  order CardOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model UserAddress {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String
  address   String   @db.Text
  city      String
  state     String?
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OrderMessage {
  id        String   @id @default(cuid())
  orderId   String
  sender    String   // ADMIN, USER
  message   String   @db.Text
  createdAt DateTime @default(now())

  order CardOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model ShopProduct {
  id            String   @id @default(cuid())
  name          String
  category      String   @default("royal") // royal, floral, vintage, modern, velvet, etc.
  pricePerCard  Float    @default(65)
  minCopies     Int      @default(50)
  previewImage  String   @db.Text
  galleryImages String?  @db.Text // JSON array of image URLs
  badge         String?  // BESTSELLER, NEW, ROYAL LUXE, etc.
  paperType     String   @default("350 GSM Textured Metallic Gold Cardstock")
  dimensions    String   @default("5.5 x 8.5 inches")
  description   String   @db.Text
  featuresJson    String   @default("[]") @db.Text // JSON array of bullet points
  pricingTiersJson String?  @db.Text // JSON string containing custom tier pricing or percentage configuration
  canvaTemplateId String?  // Optional linked Canva Studio Template ID
  rating          Float    @default(5.0)
  reviewsCount  Int      @default(50)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([isActive, category, sortOrder, createdAt])
  @@index([isActive, sortOrder, createdAt])
}

model ShopCategory {
  id        String   @id // unique slug, e.g. "royal", "floral", "vintage", "brass", etc.
  name      String   // display name, e.g. "Royal & Heritage"
  icon      String?  // emoji or icon string, e.g. "👑", "🌸", "📜"
  type      String   @default("invitations") // "invitations" | "return_gifts"
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, isActive, sortOrder])
}

model CanvaTemplate {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  topic             String   @default("vintage") // "vintage" | "modern"
  category          String   @default("Vintage Floral")
  pricePerCard      Float    @default(30)
  minCopies         Int      @default(50)
  paperType         String?  @default("350 GSM Textured Metallic Gold Cardstock")
  badge             String?
  aspectRatio       String   @default("classic") // "portrait" | "square" | "classic"
  backgroundColor   String   @default("#F3EAD8")
  backgroundImage   String?  @db.Text
  previewImage      String?  @db.Text
  elementsJson      String   @db.Text // JSON array of CanvasElement[]
  colorVariantsJson String?  @db.Text // JSON array of ColorVariant[]
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([topic])
  @@index([isActive])
}

model ShopDimension {
  id        String   @id @default(cuid())
  label     String
  type      String   @default("invitations") // "invitations" | "return_gifts" | "all"
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, sortOrder])
}
